{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CustomChat app file",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent2": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "footer": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string"
        },
        "theme": {
          "enum": [
            "auto",
            "light",
            "dark"
          ]
        }
      }
    },
    "provider": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "mock",
            "ollama",
            "openai",
            "claude",
            "gemini",
            "openai_compatible",
            "minimax",
            "mimo",
            "deepseek",
            "groq",
            "openrouter",
            "mistral"
          ]
        },
        "model": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "api_key_env": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "timeout": {
          "type": "number"
        },
        "fallback": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "local_files",
              "http_json",
              "pubmed",
              "arxiv",
              "python"
            ]
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "refresh_interval": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400
          },
          "ocr": {
            "type": "boolean"
          },
          "semantic_model": {
            "type": "string"
          },
          "rerank_model": {
            "type": "string"
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "min_score": {
          "type": "number"
        },
        "query_rewrite": {
          "type": "boolean"
        },
        "cache_ttl": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "prompt": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "style": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "no_evidence": {
          "type": "string"
        },
        "answer_note": {
          "type": "string"
        },
        "revise": {
          "type": "boolean"
        }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "recent_turns": {
          "type": "integer"
        },
        "summary_every": {
          "type": "integer"
        }
      }
    },
    "citations": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "ledger": {
          "type": "boolean"
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "none",
            "token",
            "accounts"
          ]
        },
        "token_env": {
          "type": "string"
        },
        "signup": {
          "type": [
            "string",
            "boolean"
          ]
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daily_questions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "user_daily_questions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "daily_model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "spend_cap_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Version 1; omitted in legacy files."
    }
  }
        }
